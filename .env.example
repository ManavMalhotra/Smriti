# Smriti Environment Configuration
# Copy this file to .env and supply your configuration.

# Optional Google Gemini API key. Cloud review remains off unless requested per upload.
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# PaddleOCR is large; keep disabled on 8 GB machines unless explicitly needed.
SMRITI_OCR_ALLOW_PADDLE_FALLBACK=false

# Gemini model identifier (defaults to gemini-3.8-flash with thinking_level="high")
GEMINI_MODEL_ID=gemini-3.8-flash

# Runtime Profile: 'local-gpu' (default) or 'demo' (read-only, strictly offline)
SMRITI_PROFILE=local-gpu

# Optional: Cloud resolver gate (default: false)
SMRITI_RESOLVER_ENABLED=false
SMRITI_RESOLVER_PROVIDER=local_rules

# Server Port (default: 8000)
SMRITI_PORT=8000
